# Task-shaped specialization proving the visible exploration library can reuse
# a repair frontier retained from a failed child. The library rejects the
# proposed lexical candidate, restores the same retained frontier, and accepts
# the fallback without replaying owner setup.


def owner_ready(step):
    probe = run(["test", "-s", "problem.txt"])
    return workflow_evidence(
        probe.ok,
        "owner problem is ready" if probe.ok else "owner problem is absent",
        ["retained-canary:problem-ready"] if probe.ok else [],
    )


def prepare_owner(step):
    write_file("problem.txt", "stressed\n")
    return {"ok": True}


def setup_owner(input):
    stage = workflow_stage(
        "prepare-retained-problem",
        evidence=owner_ready,
        action=prepare_owner,
        checkpoint="repairable",
    )
    report = workflow_run(workflow("prepare-retained-exploration", stage))
    if not report.ok or report.stages[0].checkpoint.status != "created":
        fail(
            "failed to prepare retained exploration frontier",
            code="retained_explore_prepare_failed",
            detail=report,
        )
    return {"checkpoint": report.stages[0].checkpoint}


def propose_lexical_first(candidates):
    return {
        "candidate": "deserts",
        "source": "fixture_proposal",
        "reason": "lexical edit is the first admitted hypothesis",
    }


def evaluate_candidate(item, outcome):
    result = outcome.result.value
    return {
        "accepted": result.passed,
        "summary": result.summary,
        "evidence": result.evidence,
    }


def worker(input):
    item = input.candidate
    view = agent_session().context_prompt_view
    if (
        view is None
        or view.required_keys != ["requirement.explore_target"]
    ):
        fail(
            "retained candidate did not receive the bounded context projection",
            code="retained_explore_context_projection_missing",
            detail=view,
        )
    requirement = context_read(
        keys=["requirement.explore_target"],
        limit=1,
    )
    if len(requirement) != 1:
        fail(
            "candidate did not inherit retained memory",
            code="retained_explore_memory_missing",
        )
    problem = read_text("problem.txt").strip()
    answer = item.input.answer
    write_file("answer.txt", answer + "\n")
    check = run(
        [
            "python3",
            "-c",
            "from pathlib import Path; "
            "problem=Path('/app/problem.txt').read_text().strip(); "
            "answer=Path('/app/answer.txt').read_text().strip(); "
            "raise SystemExit(0 if answer == problem[::-1] else 1)",
        ],
        timeout_ms=10000,
        max_stdout_bytes=1024,
        max_stderr_bytes=1024,
    )
    passed = answer == requirement[0].content.expected and check.ok
    context_write(
        "candidate.explore_result",
        "candidate",
        {
            "name": item.name,
            "answer": answer,
            "passed": passed,
        },
        status="verified" if passed else "contradicted",
        evidence=["retained-canary:candidate-check"],
    )
    return {
        "candidate": item.name,
        "answer": answer,
        "passed": passed,
        "summary": (
            "candidate satisfies independent reversal evidence"
            if passed
            else "candidate does not reverse the retained problem"
        ),
        "evidence": ["canary:reversal"] if passed else [],
        "problem": problem,
        "test_exit_code": check.exit_code,
        "memory_revision_after_result": attempt_info().memory_revision,
    }


def main(input):
    exhaust = get(input, "exhaust", False)
    context_write(
        "requirement.explore_target",
        "requirement",
        {"expected": "unreachable" if exhaust else "desserts"},
        status="verified",
        evidence=["retained-canary:root-requirement"],
    )
    owner_scope = attempt_scope(join_timeout_ms=60000)
    owner = attempt_fork(
        input={},
        program=current_program(),
        entrypoint="setup_owner",
        start=True,
        scope=owner_scope,
    )
    owner_outcome = attempt_join(owner, timeout_ms=60000)
    if not owner_outcome.succeeded:
        fail(
            "repair-frontier owner did not complete setup",
            code="retained_explore_owner_failed",
            detail=owner_outcome,
        )
    checkpoint = owner_outcome.result.value.checkpoint
    attempt_finish(
        "fail",
        attempt=owner,
        reason="injected late failure after retained frontier",
    )

    frontier = semantic_frontier(checkpoint, owner=owner)
    if get(input, "unwind", False):
        fail(
            "injected failure after retained frontier construction",
            code="semantic_frontier_unwind_canary",
        )
    result = explore_frontier(
        frontier=frontier,
        candidates=[
            candidate(
                name="deserts",
                input={"answer": "deserts"},
                assumptions=["one-letter lexical edit may be sufficient"],
                ensures=["answer reverses the retained problem"],
            ),
            candidate(
                name="desserts",
                input={"answer": "desserts"},
                assumptions=["double-s spelling may be required"],
                ensures=["answer reverses the retained problem"],
            ),
        ],
        worker_entrypoint="worker",
        propose=propose_lexical_first,
        evaluate=evaluate_candidate,
        max_candidates=2,
        timeout_ms=60000,
        context_prompt_view={
            "required_keys": ["requirement.explore_target"],
        },
    )
    release_error = ""
    try:
        attempt_branch(frontier)
    except Exception as error:
        release_error = str(error)
    if "released" not in release_error:
        fail(
            "released retained frontier remained branchable",
            code="retained_explore_released_frontier_reused",
            detail=release_error,
        )
    owner_cleanup = attempt_scope_close(
        owner_scope,
        reason="retained exploration owner consumed",
    )
    if not owner_cleanup.clean:
        fail(
            "retained owner scope did not close cleanly",
            code="retained_explore_owner_cleanup_failed",
            detail=owner_cleanup,
        )
    accepted_shape = (
        result.ok
        and result.status == "accepted"
        and result.outcomes[0].status == "rejected"
        and result.outcomes[1].status == "accepted"
    )
    exhausted_shape = (
        not result.ok
        and result.status == "exhausted"
        and result.outcomes[0].status == "rejected"
        and result.outcomes[1].status == "rejected"
        and result.accepted_attempt is None
    )
    if (
        result.source.type != "semantic_frontier"
        or result.source.availability != "retained"
        or result.tried != 2
        or result.release.status != "released"
        or frontier.status != "released"
        or (exhaust and not exhausted_shape)
        or (not exhaust and not accepted_shape)
    ):
        fail(
            "retained bounded exploration returned the wrong terminal shape",
            code="retained_explore_search_failed",
            detail=result,
        )

    owner_inspection = attempt_inspect(owner)
    if not owner_inspection.resources_reclaimed:
        fail(
            "retained owner resources were not reclaimed",
            code="retained_explore_owner_resources_live",
            detail=owner_inspection,
        )
    answer_exists = run(["test", "-e", "answer.txt"]).ok
    answer = read_text("answer.txt").strip() if answer_exists else None
    parent_keys = map(lambda item: item.key, context_read(limit=8))
    if (exhaust and answer_exists) or (not exhaust and answer != "desserts"):
        fail(
            "parent workspace does not match retained exploration terminal state",
            code="retained_explore_accept_failed",
        )
    if parent_keys != ["requirement.explore_target"]:
        fail(
            "retained candidate memory leaked into parent",
            code="retained_explore_memory_leak",
            detail=parent_keys,
        )
    return {
        "answer": answer,
        "checkpoint": checkpoint.reference,
        "origin": result.source.availability,
        "source_type": result.source.type,
        "status": result.status,
        "release": result.release,
        "frontier_status": frontier.status,
        "release_guard": True,
        "proposal": result.proposal,
        "outcomes": result.outcomes,
        "accepted_attempt": result.accepted_attempt,
        "tried": result.tried,
        "clean": result.clean and owner_cleanup.clean,
        "parent_keys": parent_keys,
        "owner_resource_state": owner_inspection.resource_state,
    }


control = attempt_info()
entrypoint = get(control.metadata, "program_entrypoint", "main")
if entrypoint == "worker":
    result = worker(task_input())
elif entrypoint == "setup_owner":
    result = setup_owner(task_input())
else:
    result = main(task_input())
attempt_report(
    status="succeeded",
    result=result,
    metadata={"control": "bounded_explore_retained_canary_v1"},
)
emit(result)
