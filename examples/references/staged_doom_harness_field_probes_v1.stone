# Field-directed inspection experiment for make-doom-for-mips.
#
# The inspection contract names the semantic obligations, their observation
# kinds, and the concrete questions to answer. Four probe actions plus one
# final decision plus bounded refinements fit the nine-action budget. The standard controller binds
# every observation to one field and the workflow runtime owns provenance.

workflow project:
    stage inspect(
        goal="inspect the Doom source, target runtime, and build requirements",
        max_actions=9,
    ):
        agent_loop()
        ensure decision_recorded(resolved={
            "source_layout": {
                "kind": "path",
                "question": "Which directory contains the Doom C sources?",
            },
            "toolchain": {
                "kind": "command",
                "question": "Which compiler and flags produce the required MIPS ELF?",
            },
            "frame_backend": {
                "kind": "file",
                "question": "Which source implements the required frame writer?",
            },
            "runtime_contract": {
                "kind": "command",
                "question": "How does vm.js invoke the ELF and what output does it require?",
            },
        })

    stage build(
        goal="build the doomgeneric_mips ELF using the supplied frame writer",
        max_actions=12,
        checkpoint="repairable",
    ):
        agent_loop()
        ensure artifact("doomgeneric_mips", format="elf", arch="mips")

    stage run(
        goal="run the supplied VM and confirm its observable output",
        max_actions=3,
    ):
        agent_loop()
        ensure command_succeeded(["node", "vm.js"])
        ensure stdout_nonempty()
        ensure file_valid("/tmp/frame.bmp", format="bmp", nonempty=True)

run project
