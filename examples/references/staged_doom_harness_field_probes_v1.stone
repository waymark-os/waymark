# Field-directed inspection experiment for make-doom-for-mips.
#
# The inspection contract names the semantic obligations, their observation
# kinds, and the concrete questions to answer. Four probe actions plus one
# final decision plus locator and sufficiency refinements fit the fourteen-action
# budget. The standard controller binds every observation to one field and the
# workflow runtime owns provenance.

workflow project:
    stage inspect(
        goal="inspect the Doom source, target runtime, and build requirements",
        max_actions=14,
    ):
        agent_loop()
        ensure decision_recorded(resolved={
            "source_layout": {
                "kind": "path",
                "question": "Which directory and build file contain the Doom C sources?",
                "evidence": {
                    "tool": "find",
                    "contains": ["doomgeneric.c", "Makefile"],
                    "success": True,
                },
            },
            "toolchain": {
                "kind": "command",
                "question": "Which compiler/linker should produce a freestanding little-endian MIPS ELF, and what package should be installed if it is absent?",
                "evidence": {
                    "tool": "run_linux",
                    "contains": ["mips"],
                },
            },
            "frame_backend": {
                "kind": "file",
                "question": "What frame output, custom-library dependency, and entry symbol does doomgeneric_img.c require?",
                "evidence": {
                    "tool": "read",
                    "contains": ["/tmp/frame.bmp", "my_stdlib.h", "__start"],
                    "success": True,
                },
            },
            "runtime_contract": {
                "kind": "command",
                "question": "Which ELF sections and symbol does vm.js load before executing the program?",
                "evidence": {
                    "tool": "read",
                    "contains": ["sectionsToLoad", "symbolName === 'main'"],
                    "success": True,
                },
            },
        })

    stage build(
        goal="build the doomgeneric_mips ELF using the supplied frame writer",
        inputs={
            "inspect": {
                "source_layout": "path",
                "toolchain": "command",
                "frame_backend": "file",
                "runtime_contract": "command",
            },
        },
        max_actions=12,
        checkpoint="repairable",
    ):
        agent_loop()
        ensure artifact("doomgeneric_mips", format="elf", arch="mips")

    stage run(
        goal="run the supplied VM and confirm its observable output",
        inputs={
            "inspect": {
                "frame_backend": "file",
                "runtime_contract": "command",
            },
        },
        max_actions=3,
    ):
        agent_loop()
        ensure command_succeeded(["node", "vm.js"])
        ensure stdout_nonempty()
        ensure file_valid("/tmp/frame.bmp", format="bmp", nonempty=True)

run project
