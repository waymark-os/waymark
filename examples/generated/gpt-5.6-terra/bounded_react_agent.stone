def inner_agent():
    messages = [
        {"role": "system", "content": "You are a bounded inner agent. Return exactly one JSON object and no other text. The object must be either {\"kind\":\"run\",\"argv\":[...]} or {\"kind\":\"finish\",\"answer\":\"...\"}."},
        {"role": "user", "content": "Produce the final answer ready. A run action is optional."}
    ]
    for turn in range(4):
        response = model_call(messages, model_class="agent", max_output_tokens=128)
        action = json_loads(response.content)
        if action.kind == "run":
            observation = run(action.argv, timeout_ms=5000)
            messages.append({"role": "assistant", "content": response.content})
            messages.append({"role": "user", "content": json_dumps({"kind": "observation", "ok": observation.ok, "exit_code": observation.exit_code, "stdout": observation.stdout, "stderr": observation.stderr})})
        elif action.kind == "finish":
            return {"answer": action.answer, "turns": turn + 1}
        else:
            fail("inner agent returned an unsupported action kind", code="agent_invalid_action")
    fail("inner agent exceeded its turn limit", code="agent_turn_limit")

emit(inner_agent())
