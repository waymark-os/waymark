# Standard visible one-decision controller for staged workflows.
#
# A workflow block lowers `agent_loop()` to repeated calls to this function.
# The workflow kernel, not this function, owns the loop: it checks every
# `ensure` contract before the first decision and after each returned action,
# passes the current missing-contract summary in `step.evidence`, and stops at
# the stage's `max_actions` budget. Explicit stage `inputs` are available as
# typed, runtime-owned findings in `step.stage_outputs`.
#
# Extension seams:
# - replace stage_agent_messages to change context selection or prompting;
# - replace stage_agent_dispatch to add task-specific tools;
# - replace agent_loop itself to add hooks, critics, or a different policy.
# Every replacement remains ordinary admitted Stone source.

def stage_agent_schema_prompt(step):
    remaining = step.max_actions - step.attempt + 1
    resolved_fields = get(step, "resolved_decision_fields", [])
    unresolved = []
    current_findings = get(step, "findings", {})
    probes = get(step, "probes", {})
    unobserved = []
    for field in resolved_fields:
        if get(get(current_findings, field, {}), "state", "unknown") != "resolved":
            unresolved.append(field)
            if get(get(probes, field, {}), "status", "missing") != "observed":
                unobserved.append(field)
    decision_stage = "decision_recorded" in step.contracts
    allowed_now = "read, find, search, write, run_linux, or run_complete"
    if decision_stage and remaining == 1:
        allowed_now = "read, find, search, write, run_linux, run_complete, decide, finish, or final"
    elif decision_stage and len(unobserved) == 0 and len(resolved_fields) > 0:
        allowed_now = "decide, finish, or final"
    elif decision_stage and len(resolved_fields) == 0:
        allowed_now = "read, find, search, write, run_linux, run_complete, decide, finish, or final"
    return "Return {\"actions\":[A]} with exactly one A. Allowed now: " + allowed_now + ". Canonical probes: {\"tool\":\"find\",\"input\":{\"path\":\".\",\"name_glob\":\"*img*.c\"},\"for_field\":\"frame_backend\"}; {\"tool\":\"search\",\"input\":{\"path\":\"vm.js\",\"needle\":\"process.argv\"},\"for_field\":\"runtime_contract\"}; {\"tool\":\"read\",\"input\":{\"path\":\"vm.js\",\"start_line\":400,\"end_line\":500},\"for_field\":\"runtime_contract\"}. Canonical probe-and-resolve shape: {\"tool\":\"run_linux\",\"input\":{\"argv\":[\"command\",\"-v\",\"mipsel-linux-gnu-gcc\"]},\"for_field\":\"toolchain\",\"resolves\":{\"source_layout\":\"sources are under src\"}}. Canonical decision shape: {\"tool\":\"decide\",\"input\":{\"answer\":\"...\"},\"resolves\":{\"toolchain\":\"use mipsel-linux-gnu-gcc\"}}. Never replace tool with action/type, and never put answer beside tool. On a resolved-finding stage, every tool action must use for_field to name the unresolved obligation it probes. resolves may interpret only retained probe observations; the runtime supplies provenance. If an observation is insufficient, probe the same field again with a more focused action. A final decision may carry unknown={field: reason}. find is recursive, search is bounded recursive literal/regex grep, and read supports byte/tail/line ranges. Use run_linux for environment or toolchain facts and run_complete only for a bounded build/test gate. Use relative workspace paths; Linux commands see the root at /app. Do not invent outcomes or use unlisted fields."


def stage_agent_action_schema(step):
    decision_fields = get(step, "decision_fields", [])
    resolved_decision_fields = get(step, "resolved_decision_fields", [])
    unresolved_decision_fields = []
    current_findings = get(step, "findings", {})
    for field in resolved_decision_fields:
        if get(get(current_findings, field, {}), "state", "unknown") != "resolved":
            unresolved_decision_fields.append(field)
    observed_probe_fields = []
    insufficient_probe_fields = []
    unobserved_probe_fields = []
    probes = get(step, "probes", {})
    for field in unresolved_decision_fields:
        probe_status = get(get(probes, field, {}), "status", "missing")
        if probe_status == "observed":
            observed_probe_fields.append(field)
        elif probe_status == "insufficient":
            insufficient_probe_fields.append(field)
        else:
            unobserved_probe_fields.append(field)
    can_resolve = len(observed_probe_fields) > 0
    all_unresolved_observed = (
        len(unresolved_decision_fields) > 0
        and len(unobserved_probe_fields) == 0
        and len(insufficient_probe_fields) == 0
    )
    answer = {
        "type": "object",
        "properties": {"answer": {"type": "string", "minLength": 1}},
        "required": ["answer"],
        "additionalProperties": False,
    }
    if len(resolved_decision_fields) > 0:
        finding_properties = {}
        resolution_properties = {}
        unknown_properties = {}
        for field in resolved_decision_fields:
            finding_properties[field] = {
                "type": "object",
                "properties": {
                    "state": {"type": "string", "enum": ["resolved", "unknown"]},
                    "value": {"type": "string", "minLength": 1, "maxLength": 2048},
                    "basis": {"type": "string", "minLength": 1, "maxLength": 1024},
                },
                "required": ["state", "value", "basis"],
                "additionalProperties": False,
            }
            if field in observed_probe_fields:
                resolution_properties[field] = {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                }
            if field in unresolved_decision_fields:
                unknown_properties[field] = {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                }
        answer["properties"]["findings"] = {
            "type": "object",
            "properties": finding_properties,
            "required": resolved_decision_fields,
            "additionalProperties": False,
        }
        answer["properties"]["unknown"] = {
            "type": "object",
            "properties": unknown_properties,
            "additionalProperties": False,
        }
    elif len(decision_fields) > 0:
        finding_properties = {}
        for field in decision_fields:
            finding_properties[field] = {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
            }
        answer["properties"]["findings"] = {
            "type": "object",
            "properties": finding_properties,
            "required": decision_fields,
            "additionalProperties": False,
        }
        answer["required"].append("findings")
    path = {
        "type": "object",
        "properties": {
            "path": {"type": "string", "minLength": 1},
            "max_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
            "offset": {"type": "integer", "minimum": 0},
            "tail_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
            "start_line": {"type": "integer", "minimum": 1},
            "end_line": {"type": "integer", "minimum": 1},
        },
        "required": ["path"],
        "additionalProperties": False,
    }
    find_input = {
        "type": "object",
        "properties": {
            "path": {"type": "string", "minLength": 1},
            "name_glob": {"type": "string", "minLength": 1},
            "type": {"type": "string", "enum": ["file", "dir", "any"]},
            "max_depth": {"type": "integer", "minimum": 0, "maximum": 64},
        },
        "required": ["path", "name_glob"],
        "additionalProperties": False,
    }
    search_input = {
        "type": "object",
        "properties": {
            "path": {"type": "string", "minLength": 1},
            "needle": {"type": "string", "minLength": 1},
            "regex": {"type": "boolean"},
        },
        "required": ["path", "needle"],
        "additionalProperties": False,
    }
    write = {
        "type": "object",
        "properties": {
            "path": {"type": "string", "minLength": 1},
            "content": {"type": "string"},
        },
        "required": ["path", "content"],
        "additionalProperties": False,
    }
    command = {
        "type": "object",
        "properties": {
            "argv": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1,
                "maxItems": 64,
            },
            "cwd": {"type": "string", "minLength": 1},
            "stdin": {"type": "string"},
            "timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1800000,
            },
        },
        "required": ["argv"],
        "additionalProperties": False,
    }
    read_action = {
        "type": "object",
        "properties": {"tool": {"const": "read"}, "input": path},
        "required": ["tool", "input"],
        "additionalProperties": False,
    }
    find_action = {
        "type": "object",
        "properties": {"tool": {"const": "find"}, "input": find_input},
        "required": ["tool", "input"],
        "additionalProperties": False,
    }
    search_action = {
        "type": "object",
        "properties": {"tool": {"const": "search"}, "input": search_input},
        "required": ["tool", "input"],
        "additionalProperties": False,
    }
    write_action = {
        "type": "object",
        "properties": {"tool": {"const": "write"}, "input": write},
        "required": ["tool", "input"],
        "additionalProperties": False,
    }
    run_action = {
        "type": "object",
        "properties": {"tool": {"const": "run_linux"}, "input": command},
        "required": ["tool", "input"],
        "additionalProperties": False,
    }
    complete_action = {
        "type": "object",
        "properties": {"tool": {"const": "run_complete"}, "input": command},
        "required": ["tool", "input"],
        "additionalProperties": False,
    }
    if len(resolved_decision_fields) > 0:
        # Cover every still-unobserved obligation before spending more of the
        # bounded action budget refining an already-observed field. Once each
        # field has an observation, refinement may target any unresolved field.
        probe_targets = unresolved_decision_fields
        if len(unobserved_probe_fields) > 0:
            probe_targets = unobserved_probe_fields
        elif len(insufficient_probe_fields) > 0:
            probe_targets = insufficient_probe_fields
        probe_field = {"type": "string", "enum": probe_targets}
        read_action["properties"]["for_field"] = probe_field
        read_action["required"].append("for_field")
        find_action["properties"]["for_field"] = probe_field
        find_action["required"].append("for_field")
        search_action["properties"]["for_field"] = probe_field
        search_action["required"].append("for_field")
        write_action["properties"]["for_field"] = probe_field
        write_action["required"].append("for_field")
        run_action["properties"]["for_field"] = probe_field
        run_action["required"].append("for_field")
        complete_action["properties"]["for_field"] = probe_field
        complete_action["required"].append("for_field")
    decide_action = {
        "type": "object",
        "properties": {"tool": {"const": "decide"}, "input": answer},
        "required": ["tool", "input"],
        "additionalProperties": False,
    }
    finish_action = {
        "type": "object",
        "properties": {"tool": {"const": "finish"}, "input": answer},
        "required": ["tool", "input"],
        "additionalProperties": False,
    }
    final_action = {
        "type": "object",
        "properties": {"final": answer},
        "required": ["final"],
        "additionalProperties": False,
    }
    if len(resolved_decision_fields) > 0:
        unknown = {
            "type": "object",
            "properties": unknown_properties,
            "additionalProperties": False,
        }
        decide_action["properties"]["unknown"] = unknown
        finish_action["properties"]["unknown"] = unknown
        final_action["properties"]["unknown"] = unknown
        if can_resolve:
            resolutions = {
                "type": "object",
                "properties": resolution_properties,
                "additionalProperties": False,
            }
            read_action["properties"]["resolves"] = resolutions
            find_action["properties"]["resolves"] = resolutions
            search_action["properties"]["resolves"] = resolutions
            write_action["properties"]["resolves"] = resolutions
            run_action["properties"]["resolves"] = resolutions
            complete_action["properties"]["resolves"] = resolutions
            decide_action["properties"]["resolves"] = resolutions
            finish_action["properties"]["resolves"] = resolutions
            final_action["properties"]["resolves"] = resolutions
    probes = [
        read_action,
        find_action,
        search_action,
        write_action,
        run_action,
        complete_action,
    ]
    choices = probes
    remaining = step.max_actions - step.attempt + 1
    decision_stage = "decision_recorded" in step.contracts
    mode = stage_agent_mode(step)
    if decision_stage and remaining == 1:
        choices = [decide_action, finish_action, final_action]
    elif decision_stage and all_unresolved_observed:
        choices = probes + [decide_action, finish_action, final_action]
    elif decision_stage and len(unresolved_decision_fields) > 0:
        choices = probes
    elif decision_stage and len(resolved_decision_fields) > 0:
        choices = [decide_action, finish_action, final_action]
    elif decision_stage and mode == "execute_or_repair":
        choices = [write_action, complete_action, decide_action, finish_action, final_action]
    elif decision_stage:
        choices = [
            read_action,
            find_action,
            search_action,
            write_action,
            run_action,
            complete_action,
            decide_action,
            finish_action,
            final_action,
        ]
    elif remaining == 1 or mode == "execute_or_repair":
        # run_linux/run_complete differ in completion mechanics, not effect
        # intent. Either can perform the required mutation or gate command.
        choices = [write_action, run_action, complete_action]
    action = {"oneOf": choices}
    return {
        "type": "object",
        "properties": {
            "actions": {
                "type": "array",
                "items": action,
                "minItems": 1,
                "maxItems": 1,
            },
        },
        "required": ["actions"],
        "additionalProperties": False,
    }


def stage_agent_diagnostic_stream(outcome, field, tail_field, limit):
    # Process adapters expose a bounded tail specifically so long build logs do
    # not hide the final compiler/test diagnostic. Prefer it whenever present;
    # file/read outcomes have no tail and naturally fall back to their content.
    diagnostic_tail = get(outcome, tail_field, "")
    if diagnostic_tail != "":
        return slice(diagnostic_tail, 0, limit)
    return slice(get(outcome, field, ""), 0, limit)


def stage_agent_outcome_summary(outcome):
    if outcome is None:
        return None
    return {
        "ok": get(outcome, "ok", False),
        "kind": get(outcome, "kind", "unknown"),
        "path": get(outcome, "path", None),
        "argv": get(outcome, "argv", []),
        "cwd": get(outcome, "cwd", None),
        "exit_code": get(outcome, "exit_code", None),
        "stdout": stage_agent_diagnostic_stream(
            outcome, "stdout", "stdout_tail", 4096
        ),
        "stderr": stage_agent_diagnostic_stream(
            outcome, "stderr", "stderr_tail", 2048
        ),
        "content": slice(get(outcome, "content", ""), 0, 4096),
        "message": slice(get(outcome, "message", ""), 0, 2048),
        "probe_field": get(outcome, "probe_field", None),
        "probe_resolutions": get(outcome, "probe_resolutions", {}),
        "finding_values": get(outcome, "finding_values", {}),
        "unknown_findings": get(outcome, "unknown_findings", {}),
    }


def stage_agent_history_key(step):
    return "workflow." + step.workflow + "." + step.stage + ".history"


def stage_agent_history(step):
    items = context_read(keys=[stage_agent_history_key(step)], limit=1)
    if len(items) == 0:
        return []
    return get(items[0].content, "actions", [])


def stage_agent_history_item(step, action, outcome):
    return {
        "decision": step.attempt,
        "tool": get(action, "tool", "final"),
        "input": slice(json_dumps(get(action, "input", {})), 0, 768),
        "ok": get(outcome, "ok", False),
        "kind": get(outcome, "kind", "unknown"),
        "exit_code": get(outcome, "exit_code", None),
        "stdout": stage_agent_diagnostic_stream(
            outcome, "stdout", "stdout_tail", 1024
        ),
        "stderr": stage_agent_diagnostic_stream(
            outcome, "stderr", "stderr_tail", 512
        ),
        "content": slice(get(outcome, "content", ""), 0, 1024),
        "message": slice(get(outcome, "message", ""), 0, 2048),
        "probe_field": get(outcome, "probe_field", None),
        "probe_resolutions": get(outcome, "probe_resolutions", {}),
        "findings": get(outcome, "findings", {}),
        "finding_values": get(outcome, "finding_values", {}),
        "unknown_findings": get(outcome, "unknown_findings", {}),
    }


def stage_agent_mode(step):
    remaining = step.max_actions - step.attempt + 1
    if "decision_recorded" in step.contracts and remaining == 1:
        return "decision_required"
    if step.attempt * 3 <= step.max_actions:
        return "explore"
    if remaining == 1:
        return "execute_or_repair"
    previous_tool = ""
    if step.outcome is not None:
        previous_tool = get(step.outcome, "tool", "")
    current_findings = get(step, "findings", {})
    for field in get(step, "resolved_decision_fields", []):
        if get(get(current_findings, field, {}), "state", "unknown") != "resolved":
            return "resolve_findings"
    if previous_tool in ["write", "run_complete"]:
        return "diagnose_or_repair"
    return "execute_or_repair"


def stage_agent_messages(step):
    session = agent_session()
    unresolved_decision_fields = []
    pending_probe_fields = []
    missing_probe_fields = []
    insufficient_probe_fields = []
    current_findings = get(step, "findings", {})
    probes = get(step, "probes", {})
    for field in get(step, "resolved_decision_fields", []):
        if get(get(current_findings, field, {}), "state", "unknown") != "resolved":
            unresolved_decision_fields.append(field)
            probe_status = get(get(probes, field, {}), "status", "missing")
            if probe_status == "observed":
                pending_probe_fields.append(field)
            elif probe_status == "insufficient":
                insufficient_probe_fields.append(field)
            else:
                missing_probe_fields.append(field)
    focus_field = None
    if len(missing_probe_fields) > 0:
        focus_field = missing_probe_fields[0]
    elif len(insufficient_probe_fields) > 0:
        focus_field = insufficient_probe_fields[0]
    elif len(unresolved_decision_fields) > 0:
        focus_field = unresolved_decision_fields[0]
    memory = context_project(
        focus=(
            "current workflow stage, prior stage actions, concrete tool "
            "outcomes, blockers, and evidence still required"
        ),
        max_tokens=512,
    )
    return [
        {
            "role": "system",
            "content": (
                "Choose exactly one next action for the current stage. "
                "The workflow runtime independently checks the listed "
                "contracts after this action; a finish claim cannot advance "
                "the stage while evidence is missing. Commands run in the "
                "task workspace mounted at /app. When decision_recorded is "
                "the remaining contract, inspect as needed and then use "
                "decide(answer, resolves?, unknown?) to retain the stage-local decision; "
                "decision_fields lists every required non-empty finding. "
                "The runtime accumulates resolved_decision_fields as typed "
                "state with value and observation provenance. unknown is "
                "valid for the bounded report but keeps the gate open. "
                "Every probe action declares for_field. On a later action, "
                "interpret a retained observation with resolves={field: value}; "
                "the runtime supplies its provenance and rejects resolutions "
                "without a prior observation. One response may resolve an old "
                "probe while launching the next field probe. Use read for file facts "
                "and run_linux for environment or toolchain facts. Use recursive "
                "find for names, search for symbols or text, and ranged read around "
                "matches. An observed probe is not automatically sufficient: refine "
                "the same field when needed, and resolve it only when the retained "
                "evidence answers finding_specs[field].question. Empty output is "
                "retained as insufficient and must be refined, not resolved. When a "
                "finding spec has evidence={tool, contains, success}, choose probes "
                "that satisfy those executable requirements; probe.insufficiency "
                "states exactly what a refinement still owes. Do not "
                "repeat fields absent from unresolved_decision_fields. Direct "
                "the next probe at one of those unresolved fields. Do not "
                "use decide only to publish unknown state; reserve it for a "
                "resolved decision or the final bounded report. Treat "
                "stage_outputs as the authoritative typed findings exported "
                "by explicitly named input stages; consume them before "
                "rediscovering the same facts. Treat "
                "stage_history as the completed action ledger and do not "
                "repeat a successful probe unless new evidence requires it. "
                "In execute_or_repair mode, take a workspace-changing action "
                "or run the actual gate-producing build/test; read is "
                "intentionally unavailable, and run_linux is permitted only "
                "when its command changes the workspace or exercises the gate. "
                "In diagnose_or_repair mode, "
                "a failed gate has reopened bounded observation: use read or "
                "run_linux for one focused diagnostic, write for a repair, or "
                "run_complete only for the actual gate. A diagnostic action "
                "is followed by execute_or_repair mode. In decision_required mode, "
                "record the stage decision now. Return one schema-valid "
                "JSON object and never invent a tool outcome."
            ),
        },
        {
            "role": "user",
            "content": json_dumps({
                "task": session.task,
                "input": session.input,
                "workflow": step.workflow,
                "stage": step.stage,
                "stage_goal": step.goal,
                "stage_outputs": step.stage_outputs,
                "decision": step.attempt,
                "max_actions": step.max_actions,
                "remaining_actions": step.max_actions - step.attempt + 1,
                "mode": stage_agent_mode(step),
                "contract_kinds": step.contracts,
                "decision_fields": get(step, "decision_fields", []),
                "resolved_decision_fields": get(step, "resolved_decision_fields", []),
                "unresolved_decision_fields": unresolved_decision_fields,
                "finding_specs": get(step, "finding_specs", {}),
                "findings": get(step, "findings", {}),
                "probes": probes,
                "pending_probe_fields": pending_probe_fields,
                "insufficient_probe_fields": insufficient_probe_fields,
                "focus_field": focus_field,
                "probe_budget": max(step.max_actions - 1, 0),
                "remaining_probe_actions": max(
                    step.max_actions - step.attempt, 0
                ),
                "contracts": step.evidence,
                "previous_outcome": stage_agent_outcome_summary(step.outcome),
                "stage_history": stage_agent_history(step),
                "attempt_memory": memory.text,
            }),
        },
    ]


def stage_agent_dispatch(action):
    tool = action.tool
    args = action.input
    try:
        if tool == "read":
            info = stat(args.path)
            if info.is_dir:
                return {
                    "ok": True,
                    "kind": "list",
                    "path": args.path,
                    "content": slice(json_dumps(ls(args.path)), 0, 8192),
                }
            max_bytes = min(get(args, "max_bytes", 8192), 65536)
            offset = get(args, "offset", None)
            tail_bytes = get(args, "tail_bytes", None)
            start_line = get(args, "start_line", None)
            end_line = get(args, "end_line", None)
            if tail_bytes is not None:
                content = read_file(
                    args.path, max_bytes=max_bytes, tail_bytes=tail_bytes
                )
            elif offset is not None:
                content = read_file(args.path, max_bytes=max_bytes, offset=offset)
            elif start_line is not None and end_line is not None:
                content = read_file(
                    args.path,
                    max_bytes=max_bytes,
                    start_line=start_line,
                    end_line=end_line,
                )
            elif start_line is not None:
                content = read_file(
                    args.path, max_bytes=max_bytes, start_line=start_line
                )
            elif end_line is not None:
                content = read_file(args.path, max_bytes=max_bytes, end_line=end_line)
            else:
                content = read_file(args.path, max_bytes=max_bytes)
            return {
                "ok": True,
                "kind": "read",
                "path": args.path,
                "content": content,
            }
        if tool == "find":
            entries = find(
                args.path,
                args.name_glob,
                max_depth=get(args, "max_depth", 32),
                type=get(args, "type", "any"),
            )
            return {
                "ok": True,
                "kind": "find",
                "path": args.path,
                "content": slice(json_dumps(entries), 0, 8192),
            }
        if tool == "search":
            matches = search(
                args.path,
                args.needle,
                regex=get(args, "regex", False),
            )
            return {
                "ok": True,
                "kind": "search",
                "path": args.path,
                "content": slice(json_dumps(matches), 0, 8192),
            }
        if tool == "write":
            write_text(args.path, args.content)
            return {"ok": True, "kind": "write", "path": args.path}
        if tool == "run_linux":
            return run(
                args.argv,
                cwd=get(args, "cwd", None),
                stdin=get(args, "stdin", None),
                timeout_ms=min(get(args, "timeout_ms", 60000), 120000),
                max_stdout_bytes=16384,
                max_stderr_bytes=8192,
            )
        if tool == "run_complete":
            return run_complete(
                args.argv,
                cwd=get(args, "cwd", None),
                stdin=get(args, "stdin", None),
                timeout_ms=min(get(args, "timeout_ms", 900000), 1800000),
                max_stdout_bytes=16384,
                max_stderr_bytes=8192,
            )
        fail("unknown stage agent tool: " + tool, code="stage_agent_unknown_tool")
    except Exception as error:
        return {
            "ok": False,
            "kind": "tool_error",
            "tool": tool,
            "message": slice(str(error), 0, 2048),
        }


def stage_agent_remember(step, action, outcome, evidence):
    history = stage_agent_history(step)
    history.append(stage_agent_history_item(step, action, outcome))
    history = tail(history, 8)
    context_write(
        stage_agent_history_key(step),
        "outcome",
        {"actions": history},
        status=("verified" if get(outcome, "ok", False) else "contradicted"),
        evidence=evidence,
    )
    return outcome


def agent_loop(step):
    try:
        inference = model_infer(
            stage_agent_messages(step),
            stage_agent_action_schema(step),
            retries=1,
            repair_prompt=(
                "Use the allowed alternatives and nearest-branch details in "
                "the validation error. Preserve the intended action only if "
                "it is currently allowed; otherwise choose an allowed action. "
                "Use the canonical tool/input nesting exactly."
            ),
            schema_prompt=stage_agent_schema_prompt(step),
            model_class="agent",
            max_output_tokens=768,
        )
    except Exception as error:
        action = {"tool": "model_infer", "input": {}}
        error_text = str(error)
        outcome = {
            "ok": False,
            "kind": "model_schema_error",
            "tool": "model_infer",
            "message": (
                slice(error_text, 0, 384)
                + "\n... validation detail tail ...\n"
                + error_text[-1536:]
            ),
        }
        return stage_agent_remember(
            step, action, outcome, ["runtime:model_infer_validation"]
        )
    action = inference.value.actions[0]
    decision = None
    if get(action, "tool", "") == "decide":
        decision = action.input
    final = get(action, "final", None)
    if final is None and get(action, "tool", "") == "finish":
        final = action.input
    if decision is not None:
        outcome = {
            "ok": True,
            "kind": "decision_recorded",
            "message": decision.answer,
            "findings": get(decision, "findings", {}),
            "probe_resolutions": get(action, "resolves", {}),
            "unknown_findings": get(action, "unknown", get(decision, "unknown", {})),
            "transition_id": inference.response.transition_id,
        }
    elif final is not None:
        outcome = {
            "ok": True,
            "kind": "finish_requested",
            "message": final.answer,
            "findings": get(final, "findings", {}),
            "probe_resolutions": get(action, "resolves", {}),
            "unknown_findings": get(action, "unknown", get(final, "unknown", {})),
            "transition_id": inference.response.transition_id,
        }
    else:
        outcome = stage_agent_dispatch(action)
        probe_field = get(action, "for_field", None)
        if probe_field is not None:
            outcome["probe_field"] = probe_field
        resolutions = get(action, "resolves", {})
        if len(resolutions) > 0:
            outcome["probe_resolutions"] = resolutions
    outcome["tool"] = get(action, "tool", "final")
    return stage_agent_remember(
        step,
        action,
        outcome,
        ["transition:" + inference.response.transition_id],
    )
