"""Experiment 5, stage 2: fill in a model-designed specification type
(designed_spec.TaskSpec, generated by stage 1 into this run's library
directory). The checks match spec v2's for the fixed fields (cases,
changes_existing, scope); for designed fields they follow the block type:
quotes and decision evidence must appear verbatim, files must exist."""
from swe_loop import Read, Search, Shell, user, clip, work, shell
from swe_cases import case_dict, run_case, describe_case
from spec_blocks import check_quote
from designed_spec import TaskSpec

SPEC_PROBLEM = "__PROBLEM__"
DESIGN = "__DESIGN__"

CASES_HELP = """cases: concrete, runnable checks. A case may write small files under /tmp/spec/, runs a command in /testbed with the project's Python environment, and judges the result with expect, a Stone expression over r (r.exit_code, r.stdout, r.stderr), e.g. r.exit_code == 0 and "[1]" in r.stdout. Stone expressions look like Python expressions but may use only r, literals, comparisons, and/or/not, `in`, arithmetic, indexing, len, any, all, sorted, str, int, and string methods such as .splitlines(), .strip(), .startswith(), .count(). A "changes" case must fail on the current code; a "keeps" case must pass now. Try each command with the shell action before you finish."""


def describe_design(design):
    lines = ["The specification's purpose: " + design["purpose"], "", "Its fields:"]
    for field in design["fields"]:
        kind = field["type"]
        if kind == "choice":
            kind = "one of " + json_dumps(field["options"])
        lines.append("- " + field["name"] + " (" + kind + "): " + field["description"])
    lines.append("- cases: must cover " + design["cases_description"])
    lines.append("- changes_existing: existing tests whose expectations the specified behavior changes, so they fail after a correct fix, as /testbed/path/test_file.py::test_name")
    lines.append("- scope: the source files a fix should change")
    return "\n".join(lines)


def instructions(design):
    return ("Do not fix anything and do not edit files under /testbed. Read the issue and the code, then fill in the specification below, so that another engineer can carry it out without making judgment calls of their own.\n\n"
            + describe_design(design) + "\n\n" + CASES_HELP + "\n\nFinish with your specification.")


def check_spec(spec, design, problem):
    """Check the filled spec (a dict) against the repository; return (problems, case results)."""
    problems = []
    results = []
    cases = spec["cases"]
    if not [c for c in cases if c["kind"] == "changes"]:
        problems.append("no case has kind \"changes\": at least one case must show the behavior the fix changes")
    for case in cases:
        outcome = run_case(case)
        results.append({"name": case["name"], "kind": case["kind"], "passed": outcome["passed"]})
        if outcome["problem"] is not None:
            problems.append("case " + describe_case(case) + " is broken: " + outcome["problem"] + ("\n" + clip(outcome["output"], 1200) if outcome["output"] else ""))
        elif case["kind"] == "changes" and outcome["passed"]:
            problems.append("case " + describe_case(case) + " already passes on the current code, so it does not show the change; its output:\n" + clip(outcome["output"], 1200))
        elif case["kind"] == "keeps" and not outcome["passed"]:
            problems.append("case " + describe_case(case) + " fails on the current code, so it is not behavior to keep; its output:\n" + clip(outcome["output"], 1200))
    for test in spec["changes_existing"]:
        parts = test.split("::")
        if len(parts) < 2 or not parts[0].startswith("/testbed/"):
            problems.append("changes_existing entry " + test + " must look like /testbed/path/test_file.py::test_name")
            continue
        name = parts[-1].split("[")[0]
        found = shell("grep -n " + json_dumps(name) + " " + parts[0], 60, None, None)
        if found.exit_code != 0:
            problems.append("changes_existing entry " + test + ": " + name + " is not in " + parts[0])
    paths = list(spec["scope"])
    for field in design["fields"]:
        value = spec[field["name"]]
        if field["type"] == "files":
            paths = paths + value
        elif field["type"] == "quotes":
            for item in value:
                issue = check_quote(item, problem)
                if issue is not None:
                    problems.append(field["name"] + ": " + issue)
        elif field["type"] == "decisions":
            for decision in value:
                for item in decision["evidence"]:
                    issue = check_quote(item, problem)
                    if issue is not None:
                        problems.append(field["name"] + ": " + issue)
    for path in paths:
        try:
            stat(path)
        except FileNotFoundError as error:
            problems.append("file " + path + " does not exist")
    return problems, results


def fill_spec(agent, problem, design):
    must_run(["git", "config", "--global", "--add", "safe.directory", "*"])
    log = []
    messages = [user("Issue in the repository at /testbed:\n\n" + problem + "\n\n" + instructions(design))]
    filled = work(agent, messages, Read | Search | Shell | TaskSpec, 25, log, "fill")
    problems = []
    results = []
    rounds = 0
    spec = None
    if filled is not None:
        spec = json_loads(json_dumps(filled))
        problems, results = check_spec(spec, design, problem)
        log.append({"phase": "check_spec", "kind": "check", "problems": [clip(p, 400) for p in problems]})
    while filled is not None and problems and rounds < 3:
        rounds += 1
        messages.append({"role": "assistant", "content": json_dumps(filled)})
        messages.append(user("The workflow checked your specification against the repository and found problems:\n\n" + "\n\n".join(problems) + "\n\nInvestigate as needed, fix them, and finish with the corrected specification."))
        retry = work(agent, messages, Read | Search | Shell | TaskSpec, 8, log, "fill_retry" + str(rounds))
        if retry is not None:
            filled = retry
            spec = json_loads(json_dumps(filled))
            problems, results = check_spec(spec, design, problem)
            log.append({"phase": "check_spec", "kind": "check", "problems": [clip(p, 400) for p in problems]})
    if spec is not None:
        spec = {k: v for k, v in spec.items() if k != "kind"}
    return {"arm": "fill", "spec": spec, "spec_problems": problems, "case_results": results,
            "check_rounds": rounds, "usage": agent.usage, "log": log}


emit(fill_spec(model.limit(calls=45), SPEC_PROBLEM, DESIGN))
