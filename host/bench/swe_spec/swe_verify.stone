"""Experiment 6: the final verifier, a step the fixer does not control.

It returns the tree to the unfixed code, applies only the graded patch
(plain git diff), and runs gate 2 again, so leftover scratch files and
untracked files cannot fake a pass. It also runs a wider regression check:
the existing test files for the changed source files, before and after the
patch, reporting tests that newly fail (beyond the spec's revised tests).
The verdict is a typed record with the spec and patch hashes."""
from swe_loop import shell, clip
from swe_wf2 import failing_tests
from swe_wf4 import gate2
from swe_tree import set_aside, put_back

WIDER_FILES = 3


def changed_files(patch):
    files = []
    for line in patch.splitlines():
        if line.startswith("diff --git a/"):
            files.append(line.split(" b/")[-1])
    return files


def is_test_path(path):
    parts = path.lower().split("/")
    return any([p.startswith("test") or p.endswith("_test.py") or p == "testing" for p in parts])


def runner():
    try:
        stat("/testbed/tests/runtests.py")
        return "django"
    except FileNotFoundError as error:
        pass
    try:
        stat("/testbed/bin/test")
        return "sympy"
    except FileNotFoundError as error:
        return "pytest"


def changed_functions(patch, path):
    """Names of the functions the patch touches in one file, from hunk headers."""
    names = []
    current = None
    for line in patch.splitlines():
        if line.startswith("diff --git a/"):
            current = line.split(" b/")[-1]
        elif current == path and line.startswith("@@") and "def " in line:
            name = line.split("def ")[1].split("(")[0].strip()
            if name and name not in names:
                names.append(name)
    return names


def test_files_for(path, functions):
    """Existing test files for one changed source file: test_<function>.py for
    a changed function, else test_<stem>.py, else test files that name its
    dotted module."""
    name = path.split("/")[-1][:-3]
    if name == "__init__":
        name = path.split("/")[-2]
    listed = must_run(["git", "-C", "/testbed", "ls-files"], max_stdout_bytes=20000000).stdout.splitlines()
    for stem in [f.strip("_") for f in functions] + [name]:
        named = [p for p in listed if p.endswith("/test_" + stem + ".py") or p == "test_" + stem + ".py"]
        if named:
            return named[:2]
    module = path[:-3]
    for prefix in ["lib/", "src/"]:
        if module.startswith(prefix):
            module = module[len(prefix):]
    dotted = module.replace("/", ".")
    found = shell("git grep -l -F " + json_dumps(dotted) + " -- '*test*.py'", 60, None, None)
    return [p for p in found.stdout.splitlines() if p.strip() and is_test_path(p)][:2]


def wider_commands(files, patch):
    targets = []
    for path in files:
        if path.endswith(".py") and not is_test_path(path):
            for test_file in test_files_for(path, changed_functions(patch, path)):
                if test_file not in targets:
                    targets.append(test_file)
    targets = targets[:WIDER_FILES]
    kind = runner()
    commands = []
    for path in targets:
        if kind == "django" and path.startswith("tests/"):
            commands.append("python tests/runtests.py --parallel 1 " + path[len("tests/"):-3].replace("/", "."))
        elif kind == "sympy":
            commands.append("python bin/test -C " + path)
        else:
            commands.append("python -m pytest -q -p no:cacheprovider " + path)
    return commands


def run_wider(commands):
    out = []
    for command in commands:
        result = shell(command, 900, None, None)
        text = result.stdout + "\n" + result.stderr
        out.append({"command": command, "exit_code": result.exit_code, "timed_out": result.timed_out,
                    "failed": failing_tests(text)})
    return out


def regressions(before, after, revised):
    keys = [t.split("::")[-1].split("[")[0] for t in revised]
    found = []
    for i in range(min(len(before), len(after))):
        b = before[i]
        a = after[i]
        if a["timed_out"] or b["timed_out"]:
            continue
        new = [n for n in a["failed"] if n not in b["failed"] and not any([k in n for k in keys])]
        if new:
            found.append({"command": a["command"], "newly_failing": new[:20]})
        elif b["exit_code"] == 0 and a["exit_code"] != 0 and not a["failed"]:
            found.append({"command": a["command"], "newly_failing": ["(the command fails after the patch; no test names parsed)"]})
    return found


def verify(spec, baseline, untracked, fix, log):
    patch = set_aside(untracked, False)
    files = changed_files(patch)
    commands = wider_commands(files, patch)
    before = run_wider(commands)
    problem = put_back(patch)
    verdict = {"spec_hash": spec["hash"], "patch_hash": sha256(patch)[:12], "changed_files": files,
               "out_of_scope": [f for f in files if "/testbed/" + f not in spec["scope"]],
               "assumptions": [{"id": d["id"], "question": d["question"], "choice": d["choice"]} for d in spec["decisions"] if d["source"] == "guess"],
               "objections": fix["objections"], "revision": fix["revision"], "wider_commands": commands}
    if not patch.strip():
        verdict.update({"outcome": "not_verified", "reason": "the graded patch is empty", "gate2_failures": [], "tests": [], "regressions": []})
        return verdict
    if problem is not None:
        verdict.update({"outcome": "not_verified", "reason": problem, "gate2_failures": [], "tests": [], "regressions": []})
        return verdict
    failures, results = gate2(spec, baseline)
    after = run_wider(commands)
    found = regressions(before, after, [r["test"] for r in spec["revised"]])
    failed_tests = [r["test"] for r in results if "test" in r and not r["passed"]]
    objected = [o["target"] for o in fix["objections"]]
    if not failures and not found:
        outcome, reason = "verified", "every spec test passes, the keep commands hold, and no wider test newly fails"
    elif failures and failed_tests and all([t in objected for t in failed_tests]) and len(failures) == len(failed_tests):
        outcome, reason = "spec_disputed", "the only failures are spec tests the fixer objected to"
    elif failures:
        outcome, reason = "not_verified", "the spec's gate fails on a clean copy with only the patch"
    else:
        outcome, reason = "not_verified", "the spec's gate passes, but wider existing tests newly fail"
    verdict.update({"outcome": outcome, "reason": reason, "gate2_failures": [clip(f, 600) for f in failures],
                    "tests": results, "regressions": found})
    log.append({"phase": "verify", "kind": "verdict", "outcome": outcome, "regressions": len(found)})
    return verdict
