"""Luna first-move probe: A = the pilot's prompt, B = plus a framing line."""
from swe_loop import Read, Search, Shell, Note, user, SYSTEM
PROBLEM = "__PROBLEM__"
INTRO = "Issue to resolve in /testbed:\n\n" + PROBLEM + "\n\n"
ASK = INTRO + "Step 1, explore: find the code involved and the root cause. Do not edit anything yet. Finish with a report of the files involved, the root cause, how to reproduce the issue, and which existing tests cover this code."
FRAMING = " You have not looked at this repository yet; you know only what your actions show you. Each reply is one action, not your final answer: choose done only after your actions have shown you the evidence for your report."
out = {"A": [], "B": []}
for variant in ["A", "B"]:
    system = SYSTEM if variant == "A" else SYSTEM + FRAMING
    for i in range(5):
        try:
            a = model.ask([user(ASK)], output=Read | Search | Shell | Note, system=system, max_output_tokens=8000)
            out[variant].append(a.kind)
        except ModelOutputError as error:
            out[variant].append("invalid")
emit(out)
