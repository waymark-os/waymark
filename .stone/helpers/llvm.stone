# Dynamic Stone helper registrations for LLVM and debug-metadata diagnostics.
def llvm_abs_path(cwd, path):
    if path.startswith("/"):
        return path
    return cwd + "/" + path

def llvm_candidate_paths(event):
    paths = []
    for arg in event["argv"]:
        if arg.endswith(".ll") or arg.endswith(".bc") or arg.endswith(".o") or arg.endswith(".a"):
            paths.append(llvm_abs_path(event["cwd"], arg))
    return paths

def llvm_after_run(event):
    paths = llvm_candidate_paths(event)
    if len(paths) == 0 and event["ok"]:
        return None
    checks = []
    for path in paths:
        checks.append(["file", path])
        checks.append(["llvm-dis", path, "-o", "-"])
    return {
        "helper": "llvm.after_success",
        "event": event["event"],
        "family": event["family"],
        "kind": "llvm_ir_probe_available",
        "summary": "LLVM command evidence is present; inspect bitcode/textual IR and debug metadata markers explicitly.",
        "exit_code": event["exit_code"],
        "evidence": {
            "candidate_paths": paths,
            "output_mentions_debug_metadata": "!llvm.dbg.cu" in event["stdout"] or "!llvm.dbg.cu" in event["stderr"] or "DICompileUnit" in event["stdout"] or "DICompileUnit" in event["stderr"],
        },
        "next_checks": checks,
    }

def llvm_after_success(event):
    observation = llvm_after_run(event)
    if observation != None:
        observation["helper"] = "llvm.after_success"
    return observation

def llvm_after_failure(event):
    observation = llvm_after_run(event)
    if observation != None:
        observation["helper"] = "llvm.after_failure"
    return observation

hook("run.after_success", family="llvm", argv0=["clang","clang++","llc","llvm-link","llvm-dis","opt","llvm-as","llvm-ar","extract-bc","wllvm"], handler="llvm.after_success", priority=100)
hook("run.after_failure", family="llvm", argv0=["clang","clang++","llc","llvm-link","llvm-dis","opt","llvm-as","llvm-ar","extract-bc","wllvm"], handler="llvm.after_failure", priority=100)
