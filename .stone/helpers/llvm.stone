# Dynamic Stone helper registrations for LLVM and debug-metadata diagnostics.
hook("run.after_success", family="llvm", argv0=["clang","clang++","llc","llvm-link","llvm-dis","opt","llvm-as","llvm-ar","extract-bc","wllvm"], handler="llvm.after_success", priority=100)
hook("run.after_failure", family="llvm", argv0=["clang","clang++","llc","llvm-link","llvm-dis","opt","llvm-as","llvm-ar","extract-bc","wllvm"], handler="llvm.after_failure", priority=100)
