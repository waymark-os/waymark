# Dynamic Stone helper registrations for service and network validation diagnostics.
hook("run.after_success", family="service", handler="service.after_success", priority=100)
hook("run.after_failure", family="service", handler="service.after_failure", priority=100)
hook("run.after_success", family="network", handler="service.after_success", priority=50)
hook("run.after_failure", family="network", handler="service.after_failure", priority=50)
